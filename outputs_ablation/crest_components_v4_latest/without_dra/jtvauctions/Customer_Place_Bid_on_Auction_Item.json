    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At main flow Step 1, if the Customer is not signed in when attempting to place a bid (via SmartBid or Single Bid), the system interrupts the action and takes the Customer directly to the sign-in page.",
          "evidence_refs": [
            "EC-EF-016",
            "EC-EF-015"
          ],
          "step_number": 1
        },
        {
          "content": "At the QuickBid alternative to main flow Step 1, if the Customer is not signed in when clicking the 'QuickBid' button, the system prompts the Customer to sign in and then returns the Customer to the catalog page.",
          "evidence_refs": [
            "EC-EF-010"
          ],
          "step_number": 2
        },
        {
          "content": "At main flow Step 2, the Customer clicks the 'CANCEL' button in the bid confirmation pop-up dialog, cancelling the bid confirmation.",
          "evidence_refs": [
            "EC-EF-018"
          ],
          "step_number": 3
        },
        {
          "content": "At main flow Step 1, if the Customer has unresolved (unpaid) auction winnings greater than 7 days old, the system does not allow the Customer to bid.",
          "evidence_refs": [
            "EC-EF-024"
          ],
          "step_number": 4
        },
        {
          "content": "At main flow Step 1, if the Customer is subject to the escalation policy (failed to pay more than three times in a twelve-month period, unless the unpaid winnings are less than 10% of total winnings), the Customer cannot bid again until a Customer Service Rep removes the account from Review Status.",
          "evidence_refs": [
            "EC-EF-025"
          ],
          "step_number": 5
        }
      ],
      "evidence_card_ids": [
        "EC-EF-016",
        "EC-EF-015",
        "EC-EF-010",
        "EC-EF-018",
        "EC-EF-024",
        "EC-EF-025"
      ],
      "coverage_state": {
        "covered_aspect_ids": [
          "EX-not-signed-in",
          "EX-quickbid-not-signed-in",
          "EX-cancel-confirmation",
          "EX-unresolved-winnings-block",
          "EX-escalation-review-block"
        ],
        "missing_aspects": [
          "The claim asserts that after completing sign-in, the system delivers the Customer to the Product Details page. While EC-EF-015 mentions delivery to the Product Details page, it explicitly links this behavior to clicking within the product module or QuickBid, not specifically the 'Place SmartBid'/'Place Single Bid' buttons described in EC-EF-016. The union of evidence does not definitively confirm the post-sign-in destination for the specific trigger of placing a Smart/Single Bid."
        ]
      }
    },
    "postconditions": {
      "slot": "postconditions",
      "claims": [
        {
          "content": "The Customer's confirmed bid is processed, and the Customer remains on the Product Details Page of the auction item (rather than being redirected to a confirmation or checkout page).",
          "evidence_refs": [
            "EC-PO-003",
