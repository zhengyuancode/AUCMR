          ],
          "is_cross_page": true
        },
        {
          "content": "The bid is recorded with a timestamp to 1/100th of a second.",
          "evidence_refs": [
            "EC-PO-005"
          ]
        },
        {
          "content": "The system updates the 'Current High Bid' dynamically for all items without requiring a page refresh.",
          "evidence_refs": [
            "EC-PO-007"
          ]
        },
        {
          "content": "The 'My Watch List' page displays the item with the updated 'Current High Bid', 'Total Bids', 'Last Bid Time', and 'Ending Time'.",
          "evidence_refs": [
