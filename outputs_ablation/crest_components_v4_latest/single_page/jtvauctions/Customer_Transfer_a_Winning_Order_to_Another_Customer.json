    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "Before sending the email, the system verifies that the second-place finisher's account data does not match the winner's account data on Customer Name, Customer Phone Number, Customer Email Address, Customer Member ID, or Customer Billing and/or Shipping Addresses.",
          "evidence_refs": [
            "EC-MF-040",
            "EC-MF-006"
          ],
          "step_number": 1
        },
        {
          "content": "The system sends an automated email to the second-place finisher offering to sell the item at the second-place finisher's last bid price.",
          "evidence_refs": [
            "EC-MF-019",
            "EC-MF-008"
          ],
          "step_number": 2
        },
        {
          "content": "The email presents the Customer with three options: Credit Card Option, PayPal or Amazon Payments Option, and Decline Option.",
          "evidence_refs": [
            "EC-MF-020"
          ],
          "step_number": 3
        },
        {
          "content": "The Customer chooses to accept the offer by selecting either the Credit Card Option or the PayPal or Amazon Payments Option and clicking the corresponding acceptance button.",
          "evidence_refs": [
            "EC-MF-021",
            "EC-MF-022"
          ],
          "step_number": 4
        },
        {
          "content": "The system triggers an automated process to generate an order for the item. If the Customer selected the Credit Card Option, the order is generated and the item is shipped. If the Customer selected the PayPal or Amazon Payments Option, the order is generated and placed in Hold until payment is received.",
          "evidence_refs": [
            "EC-MF-004",
            "EC-MF-021",
