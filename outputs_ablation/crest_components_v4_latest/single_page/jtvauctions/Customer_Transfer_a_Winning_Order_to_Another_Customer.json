    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "Diverges from main_flow Step 1. If a match is found between the second-place finisher's account data and the winner's account data on any of Customer Name, Customer Phone Number, Customer Email Address, Customer Member ID, or Customer Billing and/or Shipping Addresses, the 2nd-Chance email is not sent.",
          "evidence_refs": [
            "EC-EF-008"
          ],
          "step_number": 1
        },
        {
          "content": "Diverges from main_flow Step 1. If the second-place finisher has two accounts and is essentially bidding against themselves, the 2nd-Chance email is not sent.",
          "evidence_refs": [
            "EC-EF-007"
          ],
          "step_number": 2
        },
        {
          "content": "Diverges from main_flow Step 2. If the second-place finisher's last bid is below the item's unit cost, the 2nd-Chance email is not sent.",
          "evidence_refs": [
            "EC-EF-005"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from main_flow Step 4. If the Customer does not respond to the 2nd-Chance email within 72 hours after the email is sent, the item is returned to auction available inventory and rescheduled for a future auction. Exit: use case terminates; the order is not transferred.",
          "evidence_refs": [
            "EC-EF-006"
          ],
