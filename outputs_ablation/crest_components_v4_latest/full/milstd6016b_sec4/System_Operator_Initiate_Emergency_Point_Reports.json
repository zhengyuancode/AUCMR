    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The System Operator, through operator action only, initiates an Emergency Point Report to report the existence of an emergency condition that requires search and rescue efforts.",
          "evidence_refs": [
            "EC-MF-002",
            "EC-G-002"
          ],
          "step_number": 1,
          "is_cross_page": true
        },
        {
          "content": "The Emergency Point Report is transmitted as a J3.1 message, with the emergency point assigned a TN(s) by the reporting JU and its position reported using geodetic latitude/longitude values; the reporting JU is then the latest JU to report the point and has R² for that point.",
          "evidence_refs": [
            "EC-MF-000",
            "EC-PO-001",
            "EC-PO-002"
          ],
          "step_number": 2,
          "is_cross_page": true
        },
        {
          "content": "Upon receipt of the initiation message, all receiving JUs accept the alert in their databases.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 3,
          "is_cross_page": true
        }
