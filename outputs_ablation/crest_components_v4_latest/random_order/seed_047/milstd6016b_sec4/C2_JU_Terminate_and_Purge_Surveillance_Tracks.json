{
  "use_case_name": "Terminate and Purge Surveillance Tracks",
  "actor": "C2 JU",
  "slots": {
    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "If a system does not receive a J7.0 (ACT = 0) message and receives no further updates on the remote track, it may automatically purge the track after a time interval; under this automatic purge condition, a J7.0 (ACT = 0) message shall not be transmitted.",
          "evidence_refs": [
            "EC-EF-039",
            "EC-EF-043"
          ],
          "step_number": 1
        },
        {
          "content": "If the C2 JU has reporting responsibility (R²) for the dropped TN and transmits a J7.0 (ACT=0), but the dropped TN is subsequently reported by another IU, the C2 JU shall retain the dropped TN as a remote track and shall not reattempt to correlate it for 60 seconds.",
          "evidence_refs": [
            "EC-EF-020"
          ],
          "step_number": 2
        },
        {
          "content": "If the track to be dropped or purged is a DATUM (DRT=4), it shall not be purged automatically; the DATUM shall be dropped or purged only by operator action.",
          "evidence_refs": [
            "EC-EF-024",
            "EC-EF-007"
          ],
          "step_number": 3,
          "is_cross_page": true
        },
        {
          "content": "If no J7.0 (ACT=0) message is received for the dropped TN within 60 seconds from the transmission of a correlation request, the correlation shall be deemed to have failed and all associated correlation processing shall be cancelled.",
          "evidence_refs": [
            "EC-EF-036"
          ],
          "step_number": 4,
          "is_cross_page": true
        },
        {
          "content": "If for any reason, such as operator error, it is desired to change the simulation status of a track, the track shall be dropped using a J7.0 (ACT=0) message and a new track shall be reported.",
          "evidence_refs": [
            "EC-EF-017"
          ],
          "step_number": 5
        }
      ],
