    "postconditions": {
      "slot": "postconditions",
      "claims": [
        {
          "content": "Reference points and geometric areas (specifically slaved points and areas) are defined in relation to the Related TN.",
          "evidence_refs": [
            "EC-PO-002"
          ]
        },
        {
          "content": "Upon successful definition of a slaved point or area, its position is established as Delta Latitude/Delta Longitude from the Related TN at the time of the report, and the Slaved Indicator is set to value 1. The slaved point or area center is plotted as that difference regardless of whether slaving is true or relative.",
          "evidence_refs": [
            "EC-PO-004",
            "EC-PO-010"
          ]
        },
        {
          "content": "For slaved ellipses, squares, and rectangles, the Axis Orientation changes by an amount identical to the course change of the Related TN (-180 degrees if exceeding 179 degrees).",
          "evidence_refs": [
            "EC-PO-005",
            "EC-PO-011"
          ]
        },
        {
          "content": "If the slaved filter is to move independently, 'TN, Related' is set to 'No Statement' with specified Course and Speed.",
          "evidence_refs": [
            "EC-PO-009"
          ]
        },
        {
          "content": "Movement of the slaved filter begins at the time of transmission of the J7.6 (ACT = 1) filter description report.",
          "evidence_refs": [
            "EC-PO-003",
            "EC-PO-009"
          ]
        }
      ],
      "evidence_card_ids": [
        "EC-PO-002",
