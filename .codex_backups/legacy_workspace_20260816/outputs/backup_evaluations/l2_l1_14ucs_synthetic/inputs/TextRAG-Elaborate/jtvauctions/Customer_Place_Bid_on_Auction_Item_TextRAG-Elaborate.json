    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The customer places a bid from the Product Details (Bidding) page; for SmartBid, the customer selects a SmartBid amount from the dropdown list of possible SmartBid amounts.",
          "evidence_refs": [
            "jtvauctions:P25#C96",
            "jtvauctions:P25#C97",
            "jtvauctions:P62#C269"
          ],
          "step_number": 1
