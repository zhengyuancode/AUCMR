        {
          "content": "The system checks the bidder’s sign-in status before allowing the bid to be placed.",
          "evidence_refs": [
            "jtvauctions:P25#C97"
          ],
          "step_number": 2
        },
        {
          "content": "The system displays a bid confirmation pop-up message telling the customer that they have just bid \"$XX, using a '[type] bid'\".",
          "evidence_refs": [
            "jtvauctions:P25#C96"
          ],
          "step_number": 3
        },
        {
          "content": "When this popup appears, the rest of the page is grayed out and unclickable.",
          "evidence_refs": [
            "jtvauctions:P25#C97"
          ],
          "step_number": 4
        },
        {
          "content": "The customer confirms the bid.",
          "evidence_refs": [
            "jtvauctions:P25#C96",
            "jtvauctions:P25#C97"
          ],
          "step_number": 5
        },
        {
          "content": "After the user confirms their bid, the user remains on the Product Details (Bidding) page.",
          "evidence_refs": [
            "jtvauctions:P25#C96",
            "jtvauctions:P25#C97"
          ],
          "step_number": 6
        }
      ],
