    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The System Operator initiates an Emergency Point Report through operator action only to report the existence of an emergency condition that requires search and rescue efforts.",
          "evidence_refs": [
            "EC-MF-002",
            "EC-G-002",
            "EC-G-004"
          ],
          "step_number": 1,
          "is_cross_page": true
        },
        {
          "content": "The System Operator (JU with R²) initiates an emergency alert on a track by setting the appropriate EMG IND in the J3.2 Air Track, J3.3 Surface (Maritime) Track, J3.4 Subsurface (Maritime) Track, or J3.5 Land (Ground) Point/Track message.",
          "evidence_refs": [
            "EC-MF-003"
          ],
          "step_number": 2,
          "is_cross_page": true
        },
        {
          "content": "The Emergency Point Report is transmitted as a J3.1 message.",
          "evidence_refs": [
            "EC-MF-000"
          ],
          "step_number": 3,
          "is_cross_page": true
        },
        {
          "content": "All receiving JUs accept the alert in their databases upon receipt of the initiation message.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 4,
          "is_cross_page": true
        }
      ],
