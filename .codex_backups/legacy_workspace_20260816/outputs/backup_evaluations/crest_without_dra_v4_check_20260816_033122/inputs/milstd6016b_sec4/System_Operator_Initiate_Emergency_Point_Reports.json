    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At main_flow step 2, if the System Operator attempts to initiate an emergency on a Reference Point or Space/Ballistic Missile Track, the emergency shall not be initiated.",
          "evidence_refs": [
