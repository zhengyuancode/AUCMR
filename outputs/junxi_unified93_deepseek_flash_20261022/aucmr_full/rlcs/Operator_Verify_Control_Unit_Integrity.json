      "scope_contract": {
        "goal_statement": "The system shall provide for periodic verification that current, recomputed 'Message Digest' values correspond with 'record' values computed by the development process.",
        "canonical_success_scenario": "For each control unit, the current recomputed Message Digest value corresponds with the record value computed by the development process.",
        "start_boundary": "The Operator begins a control unit integrity verification.",
        "success_boundary": "The current recomputed Message Digest values for the control units are confirmed to correspond with the development-process record values.",
        "in_scope_actions": [
          "Recompute current Message Digest values for control units.",
          "Compare recomputed Message Digest values with record values computed by the development process.",
          "Use the MD5 algorithm for Message Digest values where specified."
        ],
        "excluded_adjacent_actions": [
          "Checking operator or system commands for integrity when they change field control device state.",
          "Performing the RLCS startup control system integrity check and initializing specified tables.",
          "Issuing device commands through Operational Override.",
          "Computing the record values during the development process."
        ],
        "variant_dimensions": [
          "Message Digest algorithm, such as MD5.",
          "Periodic verification timing."
        ],
        "evidence_refs": [
