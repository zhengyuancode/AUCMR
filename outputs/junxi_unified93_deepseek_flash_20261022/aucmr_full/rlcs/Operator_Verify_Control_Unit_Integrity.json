  "use_case_name": "Verify Control Unit Integrity",
  "actor": "Operator",
  "slots": {
    "goal": {
      "slot": "goal",
      "claims": [
        {
          "content": "The system shall provide for periodic verification that current, recomputed 'Message Digest' values correspond with 'record' values computed by the development process.",
          "evidence_refs": [
            "EC-G-005",
            "EC-G-003"
          ]
        }
      ],
      "evidence_card_ids": [
