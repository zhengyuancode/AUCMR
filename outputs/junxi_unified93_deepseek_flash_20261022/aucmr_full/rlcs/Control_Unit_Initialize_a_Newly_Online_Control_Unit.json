    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At main flow step 3, if the control system integrity check performed during startup fails, successful initialization is prevented and the condition is an exception.",
          "evidence_refs": [
            "EC-EF-017"
          ],
          "step_number": 3
        },
        {
          "content": "During the startup phase that includes main flow step 3, if the startup process does not complete within 30 seconds, it is considered a failure condition requiring exception handling.",
          "evidence_refs": [
            "EC-EF-016"
          ],
          "step_number": 3
        },
        {
          "content": "At main flow step 7, if verification of the non-volatile memory items fails, such as when a Message Digest comparison fails, the affected control unit is prevented from being used in control sequences.",
          "evidence_refs": [
            "EC-EF-020",
            "EC-EF-027"
          ],
          "step_number": 7
        }
      ],
