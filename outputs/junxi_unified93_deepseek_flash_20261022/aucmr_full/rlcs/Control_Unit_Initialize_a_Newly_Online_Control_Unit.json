    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "When the control unit comes online, the RLCS identifies the control unit and all of its associated device sensors.",
          "evidence_refs": [
            "EC-MF-000"
          ],
          "step_number": 1
        },
        {
          "content": "The RLCS initializes each control unit and device sensor as it is identified using the Identify & Initialize all Devices function; depending on whether the unit is an FCU or a DCU, this includes initializing the inputs/outputs for the specific device sensors associated with that control unit type.",
          "evidence_refs": [
            "EC-MF-001",
            "EC-MF-022",
            "EC-MF-025",
            "EC-MF-026"
          ],
          "step_number": 2,
          "is_cross_page": true
        },
        {
          "content": "The RLCS performs a control system integrity check and initializes all specified tables.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 3
        },
        {
          "content": "The RLCS verifies that all cards required in that control unit are present and working properly.",
          "evidence_refs": [
            "EC-MF-030"
          ],
          "step_number": 4
        },
        {
          "content": "For each FCU and DCU control unit, the RLCS replicates from the central database server into the control unit's non-volatile, non-removable memory: Login Tables, Closure Device Timing Parameters, Air Calibration Factors, Reversible Lanes Configuration Table(s), Reversible Lanes Operating Logic, Control Sequences, and Rule Sets.",
          "evidence_refs": [
            "EC-MF-016"
          ],
          "step_number": 5
        },
        {
          "content": "When any of these non-volatile memory items is created or modified during replication, the RLCS appends or updates a UTC date/time stamp as the last step in building the time-stamped code/data section.",
          "evidence_refs": [
            "EC-MF-017",
            "EC-MF-007"
          ],
          "step_number": 6
        },
        {
          "content": "The RLCS produces a Message Digest table of one-way hash values for each Control Unit Non-Volatile Memory item and maintains the appropriate Message Digest table in non-volatile memory in the system control unit.",
          "evidence_refs": [
            "EC-MF-009",
            "EC-MF-011"
          ],
          "step_number": 7
        }
      ],
      "evidence_card_ids": [
