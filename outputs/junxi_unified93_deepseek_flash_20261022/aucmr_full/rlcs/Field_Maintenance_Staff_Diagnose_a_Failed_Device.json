    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At step 2, if device sensor status meets the Device Alarm Criteria, the system sets an alarm indicating an exception condition.",
          "evidence_refs": [
            "EC-EF-008",
            "EC-EF-009"
          ],
          "step_number": 2
        },
        {
          "content": "At step 2, when a device status has been overridden, on the screen it shall appear with a different color from the normal and alarm status colors; if overriding a device status is needed in order to proceed, the system determines whether the operator has high enough security and provides advice on how to proceed.",
          "evidence_refs": [
            "EC-EF-011",
            "EC-PO-009"
          ],
          "step_number": 2
        },
        {
          "content": "At step 3, if an alarm condition occurs, the system displays the appropriate emergency contact information; when the alarm condition is removed, the system automatically changes the alarm icon to the normal status icon, returning the display from the alarm exception to normal status.",
          "evidence_refs": [
            "EC-EF-013",
            "EC-EF-012"
          ],
          "step_number": 3
        },
        {
          "content": "At step 3, when an alarm occurs, the operator can acknowledge the alarm and has the option to silence the audible portion for a configurable number of seconds or permanently for that device only.",
          "evidence_refs": [
            "EC-EF-014"
          ],
          "step_number": 3
        },
        {
          "content": "At step 5, if a status from the device is not received upon request, the system automatically requests the status again; failure to receive a valid status after a configurable number of retries shall be considered a device failure.",
          "evidence_refs": [
            "EC-EF-001",
            "EC-EF-002"
          ],
          "step_number": 5
        },
        {
          "content": "At step 7, if a verification failure occurs, the system causes an alarm condition for the affected control unit.",
          "evidence_refs": [
            "EC-EF-005"
          ],
          "step_number": 7
        },
        {
          "content": "At step 7, if a verification failure occurs in checking the non-volatile memory items, the system prevents the affected unit from being used in control sequences.",
          "evidence_refs": [
            "EC-EF-020"
          ],
          "step_number": 7
        }
      ],
