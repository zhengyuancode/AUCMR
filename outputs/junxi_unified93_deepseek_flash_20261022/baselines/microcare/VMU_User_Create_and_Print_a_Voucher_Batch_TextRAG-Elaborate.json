        },
        {
          "content": "The voucher batch has a Batch number (2 Digit); approximately each batch will have 10 vouchers.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 3
        },
        {
          "content": "The voucher has a Voucher number (10 digit).",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 4
        },
        {
          "content": "The voucher has a Security Code.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 5
        },
        {
          "content": "All codes will be printed out in the form of Bar.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 6
        },
        {
          "content": "The provision for validity date check for the period of vouchers to be used in the program is provided.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 7
        },
        {
          "content": "The validity date can be amended or altered at the system level ONLY by the authorized user.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 8
        },
        {
          "content": "The voucher will also have MRP (maximum retail price).",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 9
        },
        {
          "content": "The voucher should have three tear off portioned slips with a sub-section tear-off for the partner.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 10
        },
        {
          "content": "Each voucher slip should contain the bar code of the Voucher with two identifications one for the client and the other for the partner.",
          "evidence_refs": [
            "microcare:P12#C27"
          ],
          "step_number": 11
        }
      ],
