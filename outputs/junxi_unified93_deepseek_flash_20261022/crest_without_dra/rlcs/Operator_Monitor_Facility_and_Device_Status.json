    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "Exception 1 — Divergence at main flow step 6 (alarm condition check): If an alarm status occurs for a device, the RLCS detects the alarm condition within 2 seconds; the GUI issues an audible alarm, displays an icon different from the okay status, and changes the color of the affected device.",
          "evidence_refs": [
            "EC-EF-010",
            "EC-EF-000",
            "EC-EF-011"
          ],
          "step_number": 1
        },
        {
          "content": "Exception 2 — Divergence at main flow step 6 (active alarm): The GUI allows the operator to acknowledge an alarm and to silence the audible portion of the alarm for a configurable number of seconds or permanently for that device only.",
          "evidence_refs": [
            "EC-EF-014"
          ],
          "step_number": 2
        },
        {
          "content": "Exception 3 — Divergence at main flow step 6 (alarm condition): In the event of an alarm condition, the system displays appropriate emergency contact information.",
          "evidence_refs": [
            "EC-EF-015"
          ],
          "step_number": 3
        },
        {
          "content": "Exception 4 — Divergence at main flow step 6 (alarm condition cleared): When the alarm condition is removed, the alarm icon automatically changes back to the normal status icon.",
          "evidence_refs": [
            "EC-EF-002"
          ],
          "step_number": 4
        },
        {
          "content": "Exception 5 — Divergence at main flow step 5 (device status receipt): Failure to receive a valid status after a configurable number of retries is considered a device failure.",
          "evidence_refs": [
            "EC-EF-006"
          ],
          "step_number": 5
        }
      ],
