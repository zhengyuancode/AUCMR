    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The Operator accesses the facility and device status display.",
          "evidence_refs": [
            "EC-TR-002",
            "EC-TR-003"
          ],
          "step_number": 1
        },
        {
          "content": "The system presents a GUI display of the I-15 Reversible Lane Control System facility geographic area, including the layout of the mainline I-15 and SR-163 freeway area.",
          "evidence_refs": [
            "EC-MF-000"
          ],
          "step_number": 2
        },
        {
          "content": "The system displays facility status information, including facility status (e.g., Open or Closed), current direction of traffic flow, customer eligibility, and current facility boundaries extending one mile in either direction.",
          "evidence_refs": [
            "EC-MF-001"
          ],
          "step_number": 3
        },
        {
          "content": "The system displays device sensor status using dynamic icons for all field device sensors and controllers.",
          "evidence_refs": [
            "EC-MF-002"
          ],
          "step_number": 4
        },
        {
          "content": "The system receives current device status information from field devices within 2 seconds of the status being issued.",
          "evidence_refs": [
            "EC-MF-008",
            "EC-MF-010"
          ],
          "step_number": 5,
          "is_cross_page": true
        },
        {
          "content": "The system checks each received status against alarm conditions for that device sensor and updates the status to indicate an alarm when an alarm condition exists.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 6
        },
        {
          "content": "The system refreshes the status display every 2 seconds.",
          "evidence_refs": [
            "EC-MF-003",
            "EC-MF-009"
          ],
          "step_number": 7
        },
        {
          "content": "The Operator views the current facility and device status information, including displayed alarm conditions and override states, on the GUI.",
          "evidence_refs": [
