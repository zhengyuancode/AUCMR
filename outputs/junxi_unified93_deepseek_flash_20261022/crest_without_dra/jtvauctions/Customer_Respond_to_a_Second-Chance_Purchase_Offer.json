    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The system presents the Returning Winners Payments Page that lists the item(s) won and prompts the customer to complete the transaction by choosing a checkout option.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 1
        },
        {
          "content": "The system provides the customer with three distinct checkout options: 'Check out with PayPal', 'Check out with Amazon', or 'Checkout Later'.",
          "evidence_refs": [
            "EC-MF-005"
          ],
          "step_number": 2
        },
        {
          "content": "The customer reviews the list of items won but not yet paid for, which includes Item #, Description, Auction Number, Amount owed, auction ending time, and a 'Pay Now' checkbox.",
          "evidence_refs": [
            "EC-MF-011"
          ],
          "step_number": 3
        },
        {
          "content": "Within three days from the time the Second-Chance email is sent, the customer chooses a payment type by clicking one of the three logo buttons: PayPal, Amazon Payments, or Checkout Later, to respond to the offer.",
          "evidence_refs": [
            "EC-MF-013",
            "EC-MF-014"
          ],
          "step_number": 4
        }
      ],
      "evidence_card_ids": [
        "EC-MF-004",
