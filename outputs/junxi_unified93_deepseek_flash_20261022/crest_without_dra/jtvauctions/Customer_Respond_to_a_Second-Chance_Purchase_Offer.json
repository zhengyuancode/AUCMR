    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At Step 4, if the customer does not respond to the Second-Chance email within 72 hours after it is sent, the item is returned to auction available inventory and rescheduled for a future auction.",
          "evidence_refs": [
            "EC-EF-002"
          ],
          "step_number": 4
        },
        {
          "content": "At Step 4, if the customer selects 'Checkout Later' and does not complete payment with Amazon or PayPal before the 7-day (168-hour) payment window expires, the order is cancelled and the item is placed into 'Hold' status.",
          "evidence_refs": [
            "EC-EF-001",
            "EC-EF-012"
          ],
          "step_number": 4
        },
        {
          "content": "At Step 4, if the customer fails to complete the transaction/payment, the Non-Payment Procedure and Locked Accounts applies: the system handles non-payment by locking accounts and defines an escalation policy for reviewing locked-account status; users who fail to complete transactions may have their accounts suspended.",
          "evidence_refs": [
            "EC-EF-005",
            "EC-EF-008",
            "EC-EF-011"
          ],
          "step_number": 4
        }
      ],
      "evidence_card_ids": [
