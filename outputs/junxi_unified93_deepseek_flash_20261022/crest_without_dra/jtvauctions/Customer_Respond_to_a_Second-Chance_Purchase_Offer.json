    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from Step 4: instead of selecting PayPal or Amazon Payments to pay immediately, the customer selects the 'Checkout Later' option; the system displays a confirmation message stating the customer has 7 days (168 hours) to pay before the order is cancelled and provides options to 'Return to Payments' or go to the 'JTVauctions Homepage'.",
          "evidence_refs": [
            "EC-AF-002"
          ],
          "step_number": 1,
          "is_cross_page": true
        }
      ],
      "evidence_card_ids": [
