    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The Customer accesses the 'My Current Bids' page to view a list of items they are currently bidding on.",
          "evidence_refs": [
            "EC-MF-000"
          ],
          "step_number": 1
        },
        {
          "content": "The system displays the current bid data sorted by ending time, with the soonest ending auction at the top.",
          "evidence_refs": [
            "EC-MF-002"
          ],
          "step_number": 2
        },
        {
          "content": "If the Customer's current bid is less than the Current High Bid, the system highlights the dollar amount in the 'My Current Bid' column in bold red.",
          "evidence_refs": [
            "EC-MF-003"
          ],
          "step_number": 3
        },
        {
          "content": "The Customer accesses the 'My Bid History' page.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 4
        },
        {
          "content": "The system displays the 'My Bid History' page with 'Items I've Won' and 'Items I Bid On, But Did Not Win' sections.",
          "evidence_refs": [
            "EC-MF-004"
          ],
          "step_number": 5
        },
        {
          "content": "The system sorts the auction lists by ending time, with the most recent items appearing at the top.",
          "evidence_refs": [
            "EC-MF-005"
          ],
          "step_number": 6
        },
        {
          "content": "For won items, the system displays a Payment Status column showing 'Paid' if the default payment type is a credit card, or 'Not Paid' in bold red if the default is PayPal or Amazon Payments and the Customer has not yet paid.",
          "evidence_refs": [
            "EC-MF-007"
          ],
          "step_number": 7
