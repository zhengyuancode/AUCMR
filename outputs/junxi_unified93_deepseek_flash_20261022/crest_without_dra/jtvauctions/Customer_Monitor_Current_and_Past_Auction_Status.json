    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from main flow step 1: Instead of accessing the 'My Current Bids' page through the global site header, the Customer may access it directly via the vanity URL www.jtvauctions.com/mybids to monitor current auction status.",
          "evidence_refs": [
