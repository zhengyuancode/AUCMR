          ],
          "step_number": 3
        },
        {
          "content": "The Business Owner selects a report timeframe using the 'Run Lifetime Report' or 'Run Past 12 Months Report' radio buttons.",
          "evidence_refs": [
            "EC-MF-004",
            "EC-MF-014"
          ],
          "step_number": 4
        },
        {
          "content": "The Business Owner clicks the 'Go' button to execute report generation based on the selected timeframe.",
          "evidence_refs": [
            "EC-MF-015"
          ],
          "step_number": 5
        },
        {
          "content": "The system displays the RFM report output in three sections—Recency, Frequency, and Monetary—with the Recency section split into six tiers showing total accounts, revenue, orders, revenue per account, orders per account, and percentage of total accounts.",
