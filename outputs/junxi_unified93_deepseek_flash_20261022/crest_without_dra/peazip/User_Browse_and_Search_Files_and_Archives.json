            "EC-MF-023",
            "EC-MF-033"
          ],
          "step_number": 3
        },
        {
          "content": "The User navigates the filesystem hierarchy using navigation controls such as back, forward, up, and refresh.",
          "evidence_refs": [
            "EC-MF-005",
