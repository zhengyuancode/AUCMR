      "slot": "postconditions",
      "claims": [
        {
          "content": "The User has gained access to the selected object from the list of objects organized by functional hierarchy, favorites, recent history, or direct path, and the PeaZip file manager interface displays the selected location with navigation controls available.",
          "evidence_refs": [
            "EC-PO-006"
          ]
        },
        {
          "content": "The PeaZip file manager interface displays the browsed or searched files and archives as a structured list in the view mode selected by the User, with metadata columns such as Name, Type, Size (B), Packed Date/time, Attributes, and CRC.",
          "evidence_refs": [
            "EC-PO-013",
            "EC-PO-007"
          ]
        },
        {
          "content": "For drive and archive-content views, the interface displays the relevant object details: drives show Name, Type, Size (B), Free space, and Filesystem; archived contents show Name, Type, Size (B), Folders, Files, Date/time, Attributes, and Full name.",
          "evidence_refs": [
            "EC-PO-015"
          ]
        },
        {
          "content": "Upon completion of a search, whether recursive or non-recursive, the system displays the results within the current folder or subfolders as specified by the search mode triggered.",
          "evidence_refs": [
            "EC-PO-012"
          ]
        },
        {
          "content": "The status bar displays the current browsing context, such as 'Browsing: USER-PC [user]', confirming the active location within the filesystem hierarchy.",
