    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from Step 2: Instead of selecting 'Filesystem' from the File submenu, the User can select 'Recent archives' to access objects that have been recently browsed in PeaZip.",
          "evidence_refs": [
            "EC-AF-001"
          ],
          "step_number": 1
        },
        {
          "content": "Diverges from Step 2: Instead of selecting 'Filesystem' from the File submenu, the User can select 'Bookmarks' to access objects that the User has rated as favorites.",
          "evidence_refs": [
            "EC-AF-000"
          ],
          "step_number": 2
        },
        {
          "content": "Diverges from Step 2: Instead of selecting 'Filesystem' from the File submenu, the User can select 'Open path' or 'Open archive' to get direct access to a specific path of an object or a file/archive.",
          "evidence_refs": [
            "EC-AF-002"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from Step 4: Instead of navigating the filesystem hierarchy using the back, forward, and up controls, the User can navigate directly to the computer system's or archive's root using Ctrl+R.",
          "evidence_refs": [
            "EC-AF-009"
          ],
          "step_number": 4
        },
        {
          "content": "Diverges from Step 5: Instead of opening a directory or archive to continue browsing, the User can perform a non-recursive search (search in the current folder only) by pressing Ctrl+F3.",
          "evidence_refs": [
            "EC-AF-007"
          ],
          "step_number": 5
        },
        {
          "content": "Diverges from Step 6: The User can press the 'Browser' button to open a submenu that provides direct access to toggle view modes.",
