        "claims": [
          {
            "content": "C2 JU uses J3.4 messages for subsurface surveillance track data and J5.4 messages for acoustic bearing/range data derived from ASW sensors.",
            "evidence_refs": [
              "EC-MF-040",
              "EC-MF-042"
            ],
            "step_number": 1
          },
          {
            "content": "For subsurface surveillance track reporting, C2 JU provides the source of track data (Source TN).",
            "evidence_refs": [
              "EC-MF-041"
            ],
            "step_number": 2
          },
          {
            "content": "C2 JU reports established local subsurface surveillance tracks with all known parameters at the next reporting opportunity in a J3.4 message, including geodetic latitude and longitude, depth when available, velocity as course and speed, identity via the Identity field or J3.4I message, discrete identifier codes in the J7.5 message, and time of contact acquisition/loss/datum establishment in the J3.4C1 word, with all data time tagged.",
            "evidence_refs": [
              "EC-MF-006",
              "EC-MF-041"
            ],
            "step_number": 3
          },
          {
            "content": "When reporting acoustic bearing and range, C2 JU uses the J5.4 Acoustic Bearing/Range message, sets the BRT field to value 0 (Bearing and Range), populates the Bearing 1, ASW field with the bearing from the detecting sensor origin, and populates the Range field with the range.",
            "evidence_refs": [
              "EC-MF-031",
              "EC-MF-042"
            ],
            "step_number": 4
          },
          {
            "content": "C2 JU transmits the surveillance information in Network PGs.",
            "evidence_refs": [
              "EC-MF-035"
            ],
            "step_number": 5
          }
        ],
