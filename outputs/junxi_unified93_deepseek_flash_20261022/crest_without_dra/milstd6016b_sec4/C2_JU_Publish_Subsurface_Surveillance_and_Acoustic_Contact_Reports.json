    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "Diverges from main flow Step 3 when C2 JU finds a correlation with a track for which it has R² responsibility: C2 JU transmits a J7.2 Correlation message with Response Value (RV) set to 1 (Reverse Correlation Not Acceptable), ceases reporting the track, and transmits a J7.0 Drop Track message. Exit: C2 JU ceases reporting that track and sends the drop-track message.",
          "evidence_refs": [
            "EC-EF-000"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from main flow Step 3 when C2 JU determines that a Subsurface IU is no longer active on the interface and C2 JU also holds local data on that IU: C2 JU assumes R² by reporting a J3.4 Subsurface (Maritime) Track message using the inactive IU address as the reference TN; when assuming R² under these conditions, C2 JU reports Identity as Friend, maintains previous Track Number/Platform values, and sets the PPLI Track Number and Identity Indicator to value 1. Exit: the inactive IU is reported as a subsurface track under assumed R².",
          "evidence_refs": [
            "EC-EF-022",
            "EC-EF-031"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from main flow Step 3 when an inactive IU that C2 JU is reporting under assumed R² returns to the interface as an Active IU: C2 JU ceases reporting the IU and does not transmit a J7.0 (ACT = 0) message. Exit: C2 JU stops reporting that IU without sending a drop-track message.",
          "evidence_refs": [
            "EC-EF-023"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from main flow Step 3 when contact is regained after a DATUM has been reported: C2 JU reports a J3.4 message with Data Report Type (DRT) set to value 0, 1, or 2 using the same TN as the DATUM, or assigns a new TN depending on operator action. Exit: C2 JU reports the regained contact via J3.4 with DRT set to 0, 1, or 2.",
          "evidence_refs": [
            "EC-EF-008"
          ],
          "step_number": 3
        }
      ],
      "evidence_card_ids": [
        "EC-EF-000",
        "EC-EF-022",
