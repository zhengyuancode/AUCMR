    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from Step 3: C2 JU uses the J7.0 Track Management (ACT = 1) Difference Report message to report changes in track parameters without retransmitting full track data.",
          "evidence_refs": [
            "EC-AF-001"
          ],
          "step_number": 1
        },
        {
          "content": "Diverges from Step 3: when contact is lost, the decision to report a track as a DATUM is an operator function; C2 JU reports the DATUM in a J3.4 message with the same Reference TN as the track for which contact was lost and with Data Report Type (DRT) set to 4 (DATUM).",
          "evidence_refs": [
            "EC-AF-018",
            "EC-AF-019"
          ],
          "step_number": 2
        },
        {
          "content": "Diverges from Step 4: when passive bearings are ambiguous, C2 JU sets Bearing Report Type (BRT) to value 1 and reports using both the Bearing 1, ASW and Bearing 2, ASW fields of the J5.4E0 and J5.4C1 words, with the origins of both bearings being the same.",
          "evidence_refs": [
            "EC-AF-015"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from Step 4: when reporting range to an ASW contact without a bearing, C2 JU sets BRT to value 3 (Range Only) instead of the bearing-and-range report covered in Step 4.",
          "evidence_refs": [
            "EC-AF-017"
          ],
          "step_number": 4
        },
        {
          "content": "Diverges from Step 3: when an Emergency (EMG) or Force Tell (FT) alert is active, C2 JU sets the EMG IND or FT IND to 1 in the J3.4 Subsurface Track message; this is triggered by a J7.0 message (ACT=3 for EMG, ACT=4 for FT).",
          "evidence_refs": [
            "EC-AF-026"
          ],
          "step_number": 5
        },
        {
          "content": "Diverges from Step 4: when an Emergency (EMG) or Force Tell (FT) alert is active, C2 JU sets the EMG IND or FT IND to 1 in the J5.4 Acoustic Bearing/Range message; this is triggered by a J7.0 message (ACT=3 for EMG, ACT=4 for FT).",
          "evidence_refs": [
            "EC-AF-026"
          ],
          "step_number": 6
        }
      ],
      "evidence_card_ids": [
