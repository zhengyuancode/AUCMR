    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "Diverges at Step 3: when the C2 JU ceases reporting a track because it has relinquished R² to another JU, the J7.0 (ACT = 0) termination message shall not be transmitted. Exit: the termination message is suppressed.",
          "evidence_refs": [
            "EC-EF-015"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges at Step 3: if for any reason, such as operator error, it is desired to change the simulation status of a track, the track shall be dropped using the J7.0 (ACT = 0) message, and a new track shall be reported. Exit: the track is dropped and a new track is reported.",
          "evidence_refs": [
            "EC-EF-000"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges at Step 3: as an exception to the simulation-status change rule, a change from live to simulated shall be accepted if the track is being received from an FJU. Exit: the live-to-simulated change is accepted.",
          "evidence_refs": [
            "EC-EF-001"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges at Step 4: if the track selected for automatic purge is a DATUM (DRT = 4), the system shall not purge it automatically. Exit: automatic purge does not occur for that DATUM.",
          "evidence_refs": [
            "EC-EF-005"
          ],
          "step_number": 4
        },
        {
          "content": "Diverges at Step 4: for a ballistic missile track, a unit assuming R² for the ballistic missile track need not assume R² for the associated launch point; the unit no longer holding R² on the ballistic missile track may continue to report the launch point in accordance with transmit/receive rules. Exit: the associated launch point may continue to be reported.",
          "evidence_refs": [
            "EC-EF-010"
          ],
          "step_number": 4
        },
        {
          "content": "Diverges at Step 4: if contact is regained for a DATUM (a terminated subsurface track), the system shall report a J3.4 message with DRT set to value 0, 1, or 2 using the same TN as the DATUM or a new TN depending on operator action. Exit: reporting resumes via J3.4.",
          "evidence_refs": [
            "EC-EF-016"
          ],
          "step_number": 4
        }
      ],
      "evidence_card_ids": [
        "EC-EF-015",
        "EC-EF-000",
        "EC-EF-001",
        "EC-EF-005",
        "EC-EF-010",
        "EC-EF-016"
      ],
