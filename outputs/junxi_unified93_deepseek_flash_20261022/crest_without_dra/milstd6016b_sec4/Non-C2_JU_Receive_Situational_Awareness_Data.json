    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from main flow Step 2 by surveillance data category: the Non-C2 JU may receive Air surveillance data in J3.2 messages, Surface (Maritime) surveillance data in J3.3 messages, or Land (Ground) surveillance data in J3.5 (PTI = 1) messages; the received track and Reference Point data still provide situational awareness and early warning information.",
          "evidence_refs": [
            "EC-AF-032",
            "EC-AF-008"
          ],
          "step_number": 1
        },
        {
          "content": "Diverges from main flow Step 3: the Non-C2 JU may receive a J7.0 Track Management message that drops or ceases reporting a track; this changes the set of tracks received while the use case still achieves receipt of situational awareness information.",
          "evidence_refs": [
            "EC-AF-001",
            "EC-AF-015",
            "EC-AF-008"
          ],
          "step_number": 2
        },
        {
          "content": "Diverges from main flow Step 3: the Non-C2 JU may receive a J7.0 Track Management message reporting differences in Environment/Category and/or ID for a track; this changes the track metadata received while the use case still achieves receipt of situational awareness information.",
          "evidence_refs": [
            "EC-AF-001",
            "EC-AF-016",
            "EC-AF-008"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from main flow Step 3: the Non-C2 JU may receive other Information Management data, including J7.1 Data Update Requests and J7.2 Correlation messages, to ensure correct exchange of the surveillance data it receives.",
          "evidence_refs": [
            "EC-AF-001"
          ],
          "step_number": 4
        }
      ],
