    "alternative_flow": {
      "slot": "alternative_flow",
      "claims": [
        {
          "content": "Diverges from Step 5 when the Environment/Category changes from SPACE TRK to AIR TRK or SURF TRK: C2 JU retains the original Track Number and reports the entity in the appropriate J3.x surveillance message; if the change is proposed by J7.0 (ACT = 1), the R² JU must manually accept or reject it, and data does not change until after acceptance.",
          "evidence_refs": [
            "EC-AF-010"
          ],
          "step_number": 1
        },
        {
          "content": "Diverges from Step 2 upon receipt of a J7.5 (ACT = 0) message: C2 JU automatically sets the designated mode(s) for the specified track to the No Data status.",
          "evidence_refs": [
            "EC-AF-019"
          ],
          "step_number": 2
        },
        {
          "content": "Diverges from Step 3 when the clearing function (J7.5 (ACT = 0)) changes a Valid Data value to No Data status: C2 JU does not transmit a change report for that transition.",
          "evidence_refs": [
            "EC-AF-006"
          ],
          "step_number": 3
        },
        {
          "content": "Diverges from Step 3 when a J7.5 (ACT = 0) message results in no IFF/SIF data being held: C2 JU does not continue transmitting the periodic J3 message that includes the continuation word containing IFF/SIF data.",
          "evidence_refs": [
            "EC-AF-020"
          ],
          "step_number": 4
        },
        {
          "content": "Diverges from Step 2 when the R² unit reports a No Data status (value 0) for one or more modes in a required IFF/SIF Surveillance data report: C2 JU data updating occurs spontaneously.",
          "evidence_refs": [
            "EC-AF-022"
          ],
          "step_number": 5
        }
      ],
