          ],
          "step_number": 2
        },
        {
          "content": "C2 JU reports all IFF/SIF valid data locally held for the track in accordance with the J3 message transmit rules, reporting No Data as zeroes when no valid code is currently held.",
          "evidence_refs": [
            "EC-MF-005",
            "EC-MF-006"
          ],
          "step_number": 3
        },
        {
          "content": "C2 JU reports the Identity as Friend.",
          "evidence_refs": [
            "EC-MF-002"
          ],
          "step_number": 4
        },
        {
          "content": "C2 JU reports the Track Number, Platform, and Platform Activity values received in previous PPLI messages.",
          "evidence_refs": [
            "EC-MF-003"
          ],
          "step_number": 5
        },
        {
          "content": "C2 JU waits the minimum 12 seconds before reporting the Air or Surface track.",
          "evidence_refs": [
            "EC-MF-009"
          ],
          "step_number": 6
        },
        {
          "content": "C2 JU, having assumed R² for the IU, reports the Air or Surface surveillance track via the interface as a track or point on the Surveillance Network PG.",
