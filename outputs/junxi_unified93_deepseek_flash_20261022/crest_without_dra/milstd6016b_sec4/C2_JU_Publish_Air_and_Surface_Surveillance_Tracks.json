    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "When an operator receives an IFF/SIF data conflict alert, the operator has the following manual actions available for attempting resolution of the difference: (1) update local data manually or verify automatic inputs; (2) initiate J7.5 (ACT = 0) Clear IFF/SIF message (any mode); (3) initiate J7.5 (ACT = 1) IFF/SIF Difference Report message (any mode); (4) change local data to agree with remote data except in the case of Mode II code; (5) decorrelate the local data from the remote data, causing the assignment of a new track number to local data; (6) clear operator alert (any mode).",
          "evidence_refs": [
            "EC-EF-019"
          ],
          "step_number": 2
        },
        {
          "content": "If a correlation is not found for a received J2 PPLI report, the C² JU integrates it into its surveillance database; if no subsequent J2 messages are received and the C² JU still has no local data, the C² JU assumes no responsibility for reporting the subject JU on the Surveillance Network PG.",
          "evidence_refs": [
            "EC-EF-020",
            "EC-EF-001"
          ],
          "step_number": 7
        }
      ],
      "evidence_card_ids": [
