    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "C2 JU determines the type of surveillance message from the Environment/Category of the IU being reported.",
          "evidence_refs": [
            "EC-MF-001"
          ],
          "step_number": 1
        },
        {
          "content": "C2 JU determines the IFF/SIF code status for the track as Valid Data or No Data according to the specified criteria.",
          "evidence_refs": [
