    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At main_flow step 1, if the second-place finisher's bid is below the item's unit cost, the system does not send the 2nd-Chance email.",
          "evidence_refs": [
            "EC-EF-007",
            "EC-EF-015"
          ],
          "step_number": 1
        },
        {
          "content": "At main_flow step 1, if the 2nd-Chance recipient has two accounts and is essentially bidding against themselves, the system does not send the 2nd-Chance email.",
          "evidence_refs": [
            "EC-EF-009"
          ],
          "step_number": 1
        },
        {
          "content": "At main_flow step 1, if matches are found between the 2nd-Chance recipient's account data and the winner's account data on any of Customer Name, Customer Phone Number, Customer Email Address, Customer Member ID, or Customer Billing and/or Shipping Addresses, the system does not send the 2nd-Chance email.",
          "evidence_refs": [
            "EC-EF-017"
          ],
          "step_number": 1
        },
        {
          "content": "At main_flow step 3, if the second-place finisher does not respond to the 2nd-Chance email within 72 hours after the email is sent, the item is returned to auction available inventory and rescheduled for a future auction.",
          "evidence_refs": [
            "EC-EF-008"
          ],
          "step_number": 3
        }
      ],
