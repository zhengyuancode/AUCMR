      }
    },
    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The MSIU Field Office User enters the Treatment Form No, listing form numbers from claim receipt details that are not yet entered in a claim; the system captures the Treatment Form No as part of the transaction details.",
          "evidence_refs": [
            "EC-MF-010",
            "EC-MF-006"
          ],
          "step_number": 1
        },
        {
          "content": "The system lists the VSP Name from VSP Master and captures the following master details for the claim submission: Date of submission, No of Mentioned Forms, and No of Available Forms.",
          "evidence_refs": [
            "EC-MF-015",
            "EC-MF-005"
          ],
          "step_number": 2
        },
        {
          "content": "The system enforces that 'Mentioned Forms' and 'Available Forms' fields only accept numeric values.",
          "evidence_refs": [
            "EC-MF-007"
          ],
          "step_number": 3
        },
        {
          "content": "The MSIU Field Office User enters the Voucher No; the system automatically populates Client Details (Address), Details of syndromes treated, Lab Test Details, Drugs Details, Success of Treatment, Referral To Treatment, and Partner Treated information.",
          "evidence_refs": [
            "EC-MF-018"
          ],
          "step_number": 4
        },
        {
          "content": "In the transaction part, the number of forms entered must match the 'No of Available Forms'.",
          "evidence_refs": [
            "EC-MF-008"
          ],
          "step_number": 5
        },
        {
          "content": "The system accepts the claim submission only when the mandatory information is complete.",
          "evidence_refs": [
            "EC-MF-017"
          ],
          "step_number": 6
        },
        {
          "content": "The system automatically generates the Claim number using the Hospital Code as a suffix followed by an 8-digit number.",
          "evidence_refs": [
            "EC-MF-011"
          ],
          "step_number": 7
        },
        {
          "content": "Upon successful submission, the system prints a receipt document containing the VSP Name, Date of Submission (with time), No of claims mentioned, No of claims Available, and Treatment Form No.",
          "evidence_refs": [
            "EC-MF-009",
            "EC-MF-016"
          ],
          "step_number": 8
        }
      ],
      "evidence_card_ids": [
