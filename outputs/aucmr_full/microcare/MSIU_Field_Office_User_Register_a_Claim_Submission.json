    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "At main_flow step 6, if mandatory information is missing (including the master-level fields Syndrome, Clinical Examination, Diagnosis, Lab Test, Drugs, and Other Measures, with Contact No as the sole exception) or false information exists, the system does not accept the claim; the claim status changes to a non-'Accepted' status such as 'Rejection' or 'Quarantine', the claim is rejected back to the VSP, the system keeps the claim in a quarantine area, and the system captures the reason for the 'Rejection' or 'Quarantine' status.",
          "evidence_refs": [
            "EC-EF-008",
            "EC-EF-004",
            "EC-EF-000",
            "EC-EF-016"
          ],
          "step_number": 6
        },
        {
          "content": "At main_flow step 6, for a claim placed in quarantine due to missing or false mandatory information, if the VSP returns the quarantined claim with satisfactory details, the claim is entered into the system in the following month's batch.",
          "evidence_refs": [
            "EC-EF-010"
          ],
          "step_number": 6
        }
      ],
      "evidence_card_ids": [
        "EC-EF-008",
