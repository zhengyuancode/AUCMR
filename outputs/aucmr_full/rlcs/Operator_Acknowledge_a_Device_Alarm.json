    "exception_flow": {
      "slot": "exception_flow",
      "claims": [
        {
          "content": "If the alarm condition is removed, the alarm icon automatically changes to the normal status icon.",
          "evidence_refs": [
            "EC-EF-001"
          ],
          "step_number": 1
        },
        {
          "content": "At main-flow Step 3, if the system does not receive a response or complete the acknowledgment command within the Device Command Timeout duration, a timeout exception condition may occur; the system increments the Command Failure Count and tracks failed commands, and if a valid status is not received after a configurable number of retries, this is considered a device failure.",
          "evidence_refs": [
            "EC-EF-005",
            "EC-PO-008",
            "EC-EF-009"
          ],
          "step_number": 2
        },
        {
          "content": "Failure to receive a valid status after a configurable number of retries shall be considered a device failure.",
          "evidence_refs": [
