    "main_flow": {
      "slot": "main_flow",
      "claims": [
        {
          "content": "The GUI presents the affected device with an alarm status, including an audible alarm and a changed icon/color for that device.",
          "evidence_refs": [
            "EC-PC-001",
            "EC-TR-000"
          ],
          "step_number": 1
        },
        {
          "content": "The Operator uses the GUI acknowledgment action to acknowledge the device alarm and, optionally, selects a silencing option for the audible portion: for a configurable number of seconds or permanently for that device only.",
          "evidence_refs": [
            "EC-TR-001",
            "EC-MF-008"
          ],
          "step_number": 2
        },
        {
          "content": "The system executes the alarm-acknowledgment command according to the Device Command Timeout attribute, waits for the command response or timeout, and upon successful acknowledgment updates the alarm acknowledgment state and the Device Sensor Status data flow within 2 seconds.",
          "evidence_refs": [
            "EC-MF-003",
            "EC-PO-002",
            "EC-PO-005",
            "EC-PO-007"
          ],
          "step_number": 3
        }
      ],
