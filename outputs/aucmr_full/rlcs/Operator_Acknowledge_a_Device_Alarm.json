      "scope_contract": {
        "goal_statement": "The Operator wants to acknowledge a device alarm.",
        "canonical_success_scenario": "The Operator is presented with an alarm in the GUI and uses the acknowledgment action to acknowledge it.",
        "start_boundary": "A device alarm is available for the Operator to acknowledge in the GUI.",
        "success_boundary": "The Operator has acknowledged the device alarm.",
        "in_scope_actions": [
          "Acknowledge a device alarm through the GUI."
        ],
        "excluded_adjacent_actions": [
          "Resolving the underlying device condition",
          "Administrative alarm management or downstream follow-up",
          "Responding to a critical alarm during opening or closing operation by choosing among operation-completion actions"
